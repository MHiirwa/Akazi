{
  "name": "akazi-backend",
  "version": "1.0.0",
  "description": "Akazi job platform - backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "predev": "npm run stop",
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/index.js",
    "stop": "pkill -9 -f 'tsx watch src/index.js' 2>/dev/null; pkill -9 -f 'prototype/backend/node_modules/.bin/nodemon' 2>/dev/null; lsof -ti:${PORT:-3000} | xargs kill -9 2>/dev/null || true",
    "start": "tsx src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.js",
    "test": "tsx --test --test-concurrency=1 --test-force-exit \"tests/*.test.js\"",
    "postinstall": "prisma generate"

  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1"
  }
}
